---
import Icon from '../Icon.astro';
import '../../styles/app-mock.css';

export interface SceneMeta {
  key: string;
  tab: string;
  title: string;
  paragraphs?: string[];
  list?: string[];
  pending?: boolean;
}

interface Props {
  name: string;
  label: string;
  scenes: SceneMeta[];
}

const { name, label, scenes } = Astro.props;
---
<section class="demo" data-demo={name} aria-label={label}>
  <div class="demo-tabs" role="tablist" aria-label={`${label}步驟`}>
    {scenes.map((s, i) => (
      <button type="button" role="tab" data-tab aria-selected={i === 0 ? 'true' : 'false'}>
        <span class="n">{i + 1}</span>{s.tab}
      </button>
    ))}
    <button type="button" class="demo-fs-top" data-act="fullscreen"><Icon name="arrows-fullscreen" /><span data-fs-label>全螢幕觀看</span></button>
  </div>

  <div class="demo-body">
    <div class="demo-text">
      {scenes.map((s, i) => (
        <article data-text-for={s.key} hidden={i !== 0}>
          <h3>{s.title}</h3>
          {s.pending && <p class="pending-text">待撰寫：此段說明文字由作者提供。</p>}
          {s.paragraphs?.map((p) => <p>{p}</p>)}
          {s.list && s.list.length > 0 && <ol>{s.list.map((li) => <li>{li}</li>)}</ol>}
        </article>
      ))}
    </div>

    <div class="demo-screen">
      <div class="demo-frame" tabindex="0" aria-label="系統畫面示範，按 Enter 可自己操作">
        <div class="demo-scaler" aria-hidden="true">
          <div class="demo-scroll"></div>
          <div class="demo-cursor"><svg viewBox="0 0 24 24" width="26" height="26"><path d="M4 2.5 4 19.2l4.6-4.3 3 6.6 2.9-1.3-3-6.5 6.3-.4z" fill="#fff" stroke="#1F2328" stroke-width="1.4" stroke-linejoin="round"/></svg></div>
        </div>
        <span class="demo-badge" aria-hidden="true"></span>
        <span class="demo-hint" role="status" hidden></span>
        <button type="button" class="demo-overlay"><Icon name="play-fill" />繼續播放</button>
        <div class="demo-start">
          <button type="button" class="start-fs" data-act="start-fs"><Icon name="arrows-fullscreen" />全螢幕觀看</button>
          <button type="button" class="start-play" data-act="start-play"><Icon name="play-fill" />在頁面中播放</button>
        </div>
      </div>
      <div class="demo-controls">
        <button type="button" data-act="prev"><Icon name="chevron-left" /><span>上一步</span></button>
        <button type="button" data-act="play" aria-pressed="false"><Icon name="pause-fill" class="i-pause" /><Icon name="play-fill" class="i-play" /><span data-label>暫停</span></button>
        <button type="button" data-act="next"><span>下一步</span><Icon name="chevron-right" /></button>
        <button type="button" data-act="restart"><Icon name="arrow-counterclockwise" /><span>重播此步</span></button>
        <span class="demo-status" data-status aria-live="polite"></span>
        <button type="button" data-act="fullscreen" class="fs"><Icon name="arrows-fullscreen" /><span data-fs-label>全螢幕</span></button>
      </div>
      <p class="demo-note">畫面為系統介面重現</p>
    </div>
  </div>

  <slot />
</section>

<style is:global>
  .demo { margin: 20px 0 8px; }
  .demo:fullscreen { width: 100%; margin: 0; background: var(--bg); padding: 20px var(--fs-pad, 28px); overflow: hidden; }
  .demo:fullscreen .demo-body { grid-template-columns: 260px auto; }
  .demo:fullscreen .demo-text { font-size: .9rem; }
  .demo:fullscreen .demo-text h3 { font-size: 1rem; }
  .demo:fullscreen .demo-note { display: none; }
  .demo-tabs { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; }
  .demo-tabs button { font: inherit; font-size: .9rem; display: inline-flex; align-items: center; gap: 7px; padding: 6px 12px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--muted); cursor: pointer; }
  .demo-tabs button:hover { border-color: var(--primary-light); color: var(--primary); }
  .demo-tabs button[aria-selected="true"] { border-color: var(--primary); background: var(--primary-soft); color: var(--primary); font-weight: 700; }
  .demo-tabs .n { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: var(--surface-soft); border: 1px solid var(--border); font-size: .75rem; font-weight: 700; }
  .demo-tabs button[aria-selected="true"] .n { background: var(--primary); border-color: var(--primary); color: #fff; }

  .demo-body { display: grid; grid-template-columns: minmax(300px, 1fr) auto; gap: 28px; align-items: start; }
  .demo-text h3 { margin: 4px 0 10px; font-size: 1.15rem; }
  .demo-text p { margin: 0 0 12px; color: var(--ink); }
  .demo-text ol { margin: 0; padding-left: 1.4em; }
  .demo-text li { margin-bottom: 4px; }

  .demo-screen { min-width: 0; }
  .demo-frame { position: relative; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg); cursor: pointer; }
  .demo-badge { position: absolute; bottom: 10px; left: 10px; z-index: 20; padding: 4px 10px; border-radius: var(--radius-sm); background: rgba(31, 58, 95, .88); color: #fff; font-size: .8rem; pointer-events: none; opacity: 0; }
  .demo-badge.is-shown { animation: badgeShow 4s ease forwards; }
  @keyframes badgeShow { 0%, 80% { opacity: 1; } 100% { opacity: 0; } }
  .demo-hint { position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%); z-index: 20; padding: 8px 16px; border-radius: var(--radius-sm); background: var(--ink); color: #fff; font-size: .95rem; pointer-events: none; }
  /* Paused: a small corner button, so the paused screen stays readable. */
  .demo-overlay { display: none; position: absolute; right: 12px; bottom: 12px; z-index: 30; align-items: center; gap: 6px; padding: 6px 14px; font: inherit; font-size: .9rem; font-weight: 700; border: 0; border-radius: var(--radius-sm); background: var(--primary); color: #fff; cursor: pointer; }
  .demo-overlay:hover { background: var(--primary-hover); }
  .demo.is-paused .demo-overlay { display: inline-flex; }
  /* First view: offer fullscreen before anything plays. */
  .demo-start { display: none; position: absolute; inset: 0; z-index: 31; background: rgba(245, 246, 248, .82); align-items: center; justify-content: center; gap: 12px; flex-wrap: wrap; }
  .demo.is-intro .demo-start { display: flex; }
  .demo.is-intro .demo-overlay, .demo.is-intro .demo-badge { display: none; }
  .demo-start button { font: inherit; display: inline-flex; align-items: center; gap: 8px; border-radius: var(--radius); cursor: pointer; }
  .demo-start .start-fs { padding: 16px 32px; font-size: 1.2rem; font-weight: 700; border: 0; background: var(--primary); color: #fff; }
  .demo-start .start-fs:hover { background: var(--primary-hover); }
  .demo-start .start-play { padding: 14px 22px; font-size: 1rem; border: 1px solid var(--border); background: var(--surface); color: var(--ink); }
  .demo-start .start-play:hover { border-color: var(--primary); color: var(--primary); }
  .demo-tabs .demo-fs-top { margin-left: auto; font: inherit; font-size: .9rem; font-weight: 700; display: inline-flex; align-items: center; gap: 7px; padding: 6px 14px; border: 1px solid var(--primary); border-radius: var(--radius-sm); background: var(--primary); color: #fff; cursor: pointer; }
  .demo-tabs .demo-fs-top:hover { background: var(--primary-hover); color: #fff; }
  .demo.no-fs .demo-fs-top, .demo.no-fs [data-act="fullscreen"], .demo.no-fs .start-fs { display: none; }
  .demo.is-manual .demo-frame { border-color: var(--primary); }
  .demo-scaler { position: absolute; top: 0; left: 0; width: 900px; height: 600px; transform-origin: 0 0; }
  .demo-scroll { position: absolute; inset: 0; overflow-y: auto; scrollbar-width: none; }
  .demo-scroll::-webkit-scrollbar { display: none; }
  .demo-cursor { position: absolute; top: 0; left: 0; z-index: 10; pointer-events: none; transition: transform .65s cubic-bezier(.45, .05, .25, 1), opacity .3s; }
  .demo-cursor.is-clicking svg { transform: scale(.85); }
  .demo-cursor.is-off { opacity: 0; }
  .demo-target { outline: 3px solid var(--primary) !important; outline-offset: 3px; animation: targetPulse 1.4s ease-in-out infinite; cursor: pointer; }
  @keyframes targetPulse { 50% { outline-color: rgba(31, 58, 95, .3); } }

  .demo-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 10px; }
  .demo-controls button { font: inherit; font-size: .88rem; display: inline-flex; align-items: center; gap: 5px; padding: 5px 11px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--ink); cursor: pointer; }
  .demo-controls button:hover { border-color: var(--primary); color: var(--primary); }
  .demo-controls .fs { margin-left: auto; }
  .demo .i-play { display: none; }
  .demo.is-paused .i-play { display: inline-block; }
  .demo.is-paused .i-pause { display: none; }
  .demo-status { color: var(--muted); font-size: .85rem; padding-left: 6px; }
  .demo.is-manual .demo-status { color: var(--primary); font-weight: 700; }
  .demo-note { margin: 6px 0 0; color: var(--faint); font-size: .8rem; }

  @media (max-width: 1100px) {
    .demo-body { grid-template-columns: 1fr; }
    .demo-text { order: 2; }
  }
  @media (prefers-reduced-motion: reduce) {
    .demo-target { animation: none; }
  }
</style>

<script>
  import { mountAll } from '../../scripts/demo/player';
  import { scripts } from '../../scripts/demo/scenes';
  mountAll(scripts);
</script>
