---
// All prose on this page is the author's text (教師端操作介紹_草稿.md).
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import DemoPlayer, { type SceneMeta } from '../../components/demo/DemoPlayer.astro';
import TeacherScenes from '../../components/demo/TeacherScenes.astro';

const intro = '教師端提供教師建立作業、管理評分規準、追蹤學生進度與批改作業的功能。教師可以依照課程進度建立作業，學生完成寫作、跟讀、角色扮演與心得撰寫後，教師能在同一個頁面檢視學生完整的學習歷程，並依照評分規準給予成績與回饋。以下依教師實際操作的順序，分為六個部分說明。';

const scenes: SceneMeta[] = [
  {
    key: 'rubrics', tab: '評分規準', title: '評分規準',
    paragraphs: [
      '在建立作業之前，教師需要先準備批改時使用的評分規準。每一份評分規準可以設定多個評分面向，例如寫作初稿、跟讀、模擬面試與心得，每個面向有各自的配分、評分說明與配分級距，所有面向合計為 100 分。教師也可以加入評分注意事項，提醒自己或其他批改者應留意的地方。若某個面向沒有自訂級距，系統會套用共用的五級換算，分為表現優良、符合標準、尚待加強、基礎待提升與無法評分。',
      '評分規準採用版本管理。草稿可以隨時修改或刪除，一旦發布後就不能再更動，如需調整，可點擊「建立新版」複製一份再進行修改。這樣的設計是為了確保同一份作業中，學生被評分的標準是一致的。',
    ],
  },
  {
    key: 'create', tab: '建立作業', title: '建立作業',
    paragraphs: [
      '建立作業共分為三個步驟：基本設定、評分設定與確認送出。在基本設定中，教師需要填寫作業標題與說明，以及「AI 情境主題說明」。此欄位請以英文填寫，系統會將其提供給 AI，讓 AI 了解這次面試練習的情境，在後續的練習階段給出更貼近主題的建議與提問。',
      '接著選擇題組。系統提供與五大面向對應的公版題組，每一組有四題核心題意，可以直接啟用；若公版不符合課程需求，也可以改為自訂，自行填寫四題。寫作與跟讀練習會使用原題，角色扮演的 Q1~Q4 則由 AI 保留題意後自然地改問，Q5 再依學生先前的回答進行臨場追問。由於學生會依照自己填寫的職位作答，同一組題目也能適用於應徵不同職位的學生。此外，教師可以指定班級，並設定開放與截止日期。',
      '在評分設定中，教師只需要選擇正式批改使用的評分規準。AI 練習回饋與角色扮演使用系統統一的規則，不需要另外設定。學生開始作答時，系統會固定當下的評分規準版本，之後即使更換，也只會影響新的作答。確認所有設定無誤後，點擊「建立作業」即完成，學生登入後就可以開始練習。',
    ],
  },
  {
    key: 'assignments', tab: '作業管理', title: '作業管理',
    paragraphs: [
      '作業建立完成後，會顯示在作業管理頁面。每一份作業會標示目前的開放狀態、主題，以及寫作、跟讀與角色扮演共用的四題題目。教師可以點擊「編輯」修改作業設定，已經開始作答的學生會保留原本的版本，修改只會影響新的作答。點擊「查看與批改」，即可進入該份作業的學生作業總覽。',
    ],
  },
  {
    key: 'overview', tab: '學生作業總覽', title: '學生作業總覽',
    paragraphs: [
      '在本頁面，教師可以看到所有學生在這份作業的進度、最後成績與批改狀態。教師可以透過姓名或學號搜尋學生，也可以依狀態篩選，例如只顯示「待批改」的學生，快速找到需要處理的作業。點擊「匯出成績 XLSX」，可以將全班成績匯出成試算表。',
      '若作業已經截止，仍有學生需要延後繳交，教師可以勾選學生後進行批量補繳設定，系統會寄送通知信給學生。點擊學生列的「批改」或「查看」，即可進入該位學生的作業詳情。',
    ],
  },
  {
    key: 'detail', tab: '學生作業詳情', title: '學生作業詳情',
    paragraphs: [
      '本頁面左側呈現學生的學習歷程，右側為批改面板。學習歷程依照作業流程排列，包含欲應徵的職位、草稿撰寫、AI 練習回饋、最終草稿、跟讀練習、角色扮演、AI 回饋與心得撰寫。教師可以比較 Draft 1 與 Final Draft 的差異，了解學生如何篩選與採用 AI 的建議；在跟讀練習中，可以播放示範音訊與學生的錄音，並對照語音辨識結果；在角色扮演中，則可以逐輪檢視面試官的提問與學生的回答。',
      '頁面中的「作答監考與異常時間軸」會記錄學生作答時切換分頁、嘗試貼上文字等事件。此時間軸只供教師複查使用。若學生有多次作答，可以透過嘗試次數切換檢視，也可以將作答內容匯出成 Word 或匯出錄音檔，方便保存與後續分析。如需讓學生重新作答，可點擊「允許重作」，系統會要求輸入密碼確認後，建立新的作答紀錄。',
    ],
  },
  {
    key: 'grading', tab: '批改', title: '批改',
    paragraphs: [
      '教師依照評分規準，在每一個評分面向選擇等級，系統會自動計算各項換算總分。換算總分僅作為參考，教師可以依照學生的整體表現，填入最終的評定成績。總評與改進建議為必填欄位。',
      '完成後點擊「儲存並立即公開」，成績與回饋就會公開給學生，批改狀態也會變為「已批改」。之後若需要修改成績，系統會保留每一次的成績異動紀錄，以便日後查核。',
    ],
  },
];
---
<Base title="教師端操作介紹">
  <PageHead title="教師端操作介紹" />
  <div class="wrap doc">
    <p>{intro}</p>
    <DemoPlayer name="teacher" label="教師端操作" scenes={scenes}>
      <TeacherScenes />
    </DemoPlayer>
  </div>
</Base>
